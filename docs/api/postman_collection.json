{
  "info": {
    "name": "Amrutam Telemedicine Platform API",
    "_postman_id": "018f673e-5555-7000-8000-000000000001",
    "description": "Production-grade REST collection for the Amrutam Telemedicine Platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Probes",
      "item": [
        {
          "name": "Liveness Probe",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health/live"
          }
        },
        {
          "name": "Readiness Probe",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health/ready"
          }
        }
      ]
    },
    {
      "name": "Authentication & RBAC",
      "item": [
        {
          "name": "Register Patient",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "018f673e-0001-7000-8000-000000000001" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patient.demo@amrutam.global\",\n  \"password\": \"Password123!Secure\",\n  \"role\": \"PATIENT\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login Patient",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patient.demo@amrutam.global\",\n  \"password\": \"Password123!Secure\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login Doctor (MFA Challenge)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"dr.ayurveda@amrutam.global\",\n  \"password\": \"DoctorPassword123!\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "Doctor Discovery & Availability",
      "item": [
        {
          "name": "Search Doctors (Redis Cache-Aside)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/doctors/search?specialization=Ayurvedic%20Medicine&language=English&limit=10"
          }
        },
        {
          "name": "Materialize Slots",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startDate\": \"2026-10-29\",\n  \"days\": 7\n}"
            },
            "url": "{{baseUrl}}/availability/materialize"
          }
        }
      ]
    },
    {
      "name": "Booking Saga & Payments",
      "item": [
        {
          "name": "Hold Slot (Atomic 10m TTL)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Idempotency-Key", "value": "018f673e-hold-7000-8000-000000000001" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slotId\": \"018f673e-slot-7000-8000-000000000001\"\n}"
            },
            "url": "{{baseUrl}}/bookings/hold"
          }
        },
        {
          "name": "Create Payment Intent",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"consultationId\": \"018f673e-cons-7000-8000-000000000001\"\n}"
            },
            "url": "{{baseUrl}}/payments/intent"
          }
        }
      ]
    },
    {
      "name": "Audit & Compliance",
      "item": [
        {
          "name": "Verify Cryptographic Hash Chain",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": "{{baseUrl}}/audit/verify"
          }
        }
      ]
    }
  ]
}

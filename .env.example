# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
LOG_LEVEL=info

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=amrutam_telemed
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=5000

# Redis Cache & Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Secrets (Development placeholders - NEVER use in production)
JWT_SECRET=dev-jwt-secret-at-least-32-chars-long-example
JWT_EXPIRES_IN=900s
REFRESH_TOKEN_SECRET=dev-refresh-token-secret-at-least-32-chars
REFRESH_TOKEN_EXPIRES_IN=7d
MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ENCRYPTION_KEY_VERSION=v1

# Payment Mock Provider
PAYMENT_WEBHOOK_SECRET=mock-payment-webhook-secret-32-bytes-long

# Telemetry
OTEL_SERVICE_NAME=amrutam-telemedicine-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
